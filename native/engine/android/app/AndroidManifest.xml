        </activity>
        <activity android:name="com.bytedance.sdk.openadsdk.activity.TTFullScreenVideoActivity">
            <property android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY" tools:node="remove"/>
        </activity>
        <activity android:name="com.bytedance.sdk.openadsdk.activity.TTFullScreenExpressVideoActivity">
