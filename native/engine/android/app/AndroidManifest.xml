        <activity android:name="com.bytedance.sdk.openadsdk.activity.TTPlayableLandingPageActivity">
            <property android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY" tools:node="remove"/>
        </activity>
        <activity android:name="com.bytedance.sdk.openadsdk.activity.TTVideoLandingPageLink2Activity">
            <property android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY" tools:node="remove"/>
        </activity>
        <activity android:name="com.bytedance.sdk.openadsdk.activity.TTDelegateActivity">
            <property android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY" tools:node="remove"/>
